{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@eedsh/config": ["./packages/config/src/index.ts"],
      "@eedsh/runtime": ["./packages/runtime/src/index.ts"]
    }
  },
  "include": [
    "test",
    "vitest.config.ts",
    "vitest.slow.config.ts",
    "packages/*/src",
    "packages/*/test",
    "packages/*/tsdown.config.ts"
  ]
}
