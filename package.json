{
  "name": "@eedsh/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm -r run build",
    "build:packages": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:watch": "tsc -p tsconfig.check.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "organize-imports": "biome check --write --linter-enabled=false --formatter-enabled=false .",
    "check": "biome check . && pnpm typecheck",
    "verify": "pnpm check && pnpm test && pnpm build:packages"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
