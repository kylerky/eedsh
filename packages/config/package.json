{
  "name": "@eedsh/config",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript authoring surface for eedsh profiles, built on @eedsh/plan",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@eedsh/plan": "workspace:*",
    "js-yaml": "4.3.2"
  },
  "peerDependencies": {
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@types/js-yaml": "4.0.9",
    "effect": "4.0.6"
  }
}