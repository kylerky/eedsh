{
  "name": "@eedsh/config",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript authoring surface and versioned profile plan for eedsh",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  }
}
