{
  "name": "@eedsh/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "The eedsh profile runtime bundle: reloads a published generated layer through DSH HMR",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./installation-anchor": {
      "types": "./lib/installation-anchor.d.ts",
      "default": "./lib/installation-anchor.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "bundle:check": "node scripts/bundle.ts --check",
    "bundle:write": "node scripts/bundle.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-hmr": "0.2.1-rc.2",
    "@eedsh/bundle": "workspace:*"
  }
}
